import pandas as pd
population = pd.read_csv("population.csv", skiprows=4)
land = pd.read_csv("agricultural_land.csv", skiprows=4)
population.head()
land.head()
sids = ["KIR", "MHL", "NRU", "PNG", "TUV", "KNA", "LCA", "MDV"]
pop_2023 = population[ population["Country Code"].isin(sids) ][["Country Name", "Country Code", "2023"]]
pop_2023 = pop_2023.rename( columns={"2023": "Population_2023"} )
pop_2023
land_2023 = land[ land["Country Code"].isin(sids) ][["Country Code", "2023"]]
land_2023 = land_2023.rename( columns={"2023": "Agricultural_Land_sqkm_2023"} )
land_2023
resource_base = pop_2023.merge( land_2023, on="Country Code", how="left" )
resource_base
resource_base["Agricultural_Land_ha_per_1000"] = ( resource_base["Agricultural_Land_sqkm_2023"] * 100 / (resource_base["Population_2023"] / 1000) ).round(1)
resource_base
resource_base.to_csv( "resource_base_2023.csv", index=False )
